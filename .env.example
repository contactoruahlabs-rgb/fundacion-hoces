# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env (con secretos reales) al repositorio.

# --- Base de datos (PostgreSQL vía Supabase) ---
# En el dashboard de Supabase: Project Settings → Database → Connection string.
# DATABASE_URL: usa el "Transaction pooler" (puerto 6543) — lo usa la app en cada request.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: usa la conexión directa (puerto 5432) — la usa Prisma solo para migraciones.
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:5432/postgres"

# --- Almacenamiento de imágenes y documentos (Supabase Storage) ---
# Project Settings → API. SUPABASE_SERVICE_ROLE_KEY es secreta: nunca se expone al cliente.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="reemplaza-por-la-service_role-key"
# Crea un bucket público llamado "media" (Storage → New bucket → marcar "Public bucket").
SUPABASE_BUCKET="media"

# --- Autenticación ---
# Genera un valor aleatorio largo: openssl rand -hex 32
AUTH_SECRET="reemplaza-por-un-valor-aleatorio-de-64-caracteres"

# --- Primer administrador (usado solo por scripts/create-admin.ts) ---
ADMIN_EMAIL="admin@fundacionhoces.cl"
ADMIN_PASSWORD="cambia-esta-clave-temporal"
ADMIN_NAME="Administrador Fundación HOCES"

# --- Sitio ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Correo (formulario de contacto) — opcional, documentado como pendiente de activación ---
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# CONTACT_NOTIFICATION_EMAIL=""

# --- Transbank (Webpay Plus) ---
# En integración (pruebas) puedes dejar TRANSBANK_COMMERCE_CODE y
# TRANSBANK_API_KEY vacíos: el código usa automáticamente las credenciales
# públicas de prueba que publica Transbank. Para producción, completa ambas
# con las credenciales reales entregadas por Transbank y cambia
# TRANSBANK_ENVIRONMENT a "production".
TRANSBANK_ENVIRONMENT="integration" # integration | production
TRANSBANK_COMMERCE_CODE=""
TRANSBANK_API_KEY=""

# --- Mercado Pago — FASE 2, no activo todavía ---
# MERCADOPAGO_ACCESS_TOKEN=""
# MERCADOPAGO_PUBLIC_KEY=""
